{
  "name": "web-pronterface",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop 3D printer controller",
  "author": "Patrick Bertelsen",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "electron:install": "install-electron --no",
    "postinstall": "install-electron --no && electron-builder install-app-deps"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serialport": "^13.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "7.3.6"
  }
}