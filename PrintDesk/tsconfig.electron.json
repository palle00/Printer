{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",

    "lib": [
      "ES2023"
    ],

    "types": [
      "node",
      "electron",
      "electron-vite/node"
    ],

    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",

    "src/types/desktop.ts",
    "src/types/printer-ipc.ts",
    "src/types/printer.ts",
    "src/types/gcode.ts",
    "src/gcode/**/*.ts",

    "src/print/printMath.ts",

    "src/workers/core/**/*.ts",
    "src/workers/gcode/**/*.ts",
    "src/workers/print/**/*.ts",
    "src/workers/serial/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "out",
    "release"
  ]
}
